# Add these to frontend/.env.local for local work and to Vercel project settings for deployment.
# Create a public Storefront API token from Shopify Admin > Sales channels > Headless.
REACT_APP_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
REACT_APP_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token
REACT_APP_SHOPIFY_API_VERSION=2026-10
REACT_APP_SHOPIFY_MARKET_COUNTRY=JP
